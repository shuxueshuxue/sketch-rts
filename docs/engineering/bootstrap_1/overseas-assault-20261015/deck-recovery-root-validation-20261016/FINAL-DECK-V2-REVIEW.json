  "blockingConcreteFindings": [],
  "reviewedContracts": [
    {
      "topic": "One postprocessing pass over accepted ordinary script tasks",
      "files": [
        "src/ai/bootstrap_1/policy.ts:126",
        "src/ai/planner-context.ts:69"
      ],
      "finding": "Both BootstrapCommands and public owner-planner use planBootstrapScriptEntries. The V1 naval-only hook is removed. All accepted ordinary script commands, including later items/abilities, are checked before deck selection. No-naval script request returns original entries. Original command object identities/order/scriptId are preserved by an identity-keyed FIFO map; new stop/move/queuedhold entries are tagged naval. The later wrapper can still prepend nonmoving veteran-learn commands; it is not accurate to call these unconditionally all commands of the outermost planner."
    },
    {
      "topic": "Existing tasks and finite native order provenance",
      "files": [
        "src/ai/bootstrap_1/deck-recovery.ts:53",
        "src/ai/bootstrap_1/deck-recovery.ts:64",
        "src/ai/bootstrap_1/deck-recovery.ts:98"
      ],
      "finding": "A post recognizes only its exact own deck move plus sole queued hold, the corresponding idle-with-pendinghold boundary, or matching hold alone. A changed order/queue drops memory without stop. Own posture is stopped before a new accepted order, transfer/installer, unload or enabled-charge assignment; ferries, outfitting, services, cabins/gangways, mounted owners and existing queues are excluded. Memory is a plain optional JSON record, without TTL/new compatibility state."
    },
    {
      "topic": "Release after engagement",
      "files": [
        "src/ai/bootstrap_1/deck-recovery.ts:100"
      ],
      "finding": "V2 no longer requires every original aimed foe to die. A post is retained only while an original foe participates in the same hull planner target or attacks its hull/own deck crew. No engagement or unavailable hull/patient emits stop before the original accepted tasks. This is a current planner-engagement definition, not a proximity or future safe-return guarantee."
    },
    {
      "topic": "First hull and deck geometry match native semantics",
      "files": [
        "src/ai/bootstrap_1/deck-recovery.ts:130",
        "src/shared/sim.ts:1493",
        "src/shared/sim.ts:543"
      ],
      "finding": "The first supporting hull check uses the same snapshot find order, local/world conversion, zero-radius circleInPolygon hull test as native deckPointOrder. A different first hull rejects the candidate. The endpoint must also pass actual deckPlacement, deckWalkPathExists and straight swept capsule checks against current fittings/crew. Native hold does not walk back toward its stored world anchor: that coordinate can serve as the queued-order provenance value. Geometry proves only the present straight walk, not future crew/hull motions."
    },
    {
      "topic": "Cooldown, pace and damage counting",
      "files": [
        "src/ai/bootstrap_1/deck-recovery.ts:41",
        "src/ai/bootstrap_1/deck-recovery.ts:47",
        "src/ai/bootstrap_1/deck-recovery.ts:123",
        "src/shared/sim.ts:1370",
        "src/shared/sim.ts:2730"
      ],
      "finding": "Saved cooldown is decremented before native shooting; V2 first=max(1,cooldown), inclusive final-tick formula and live veteran/temporary attack-speed period match that clock convention. Derived Unit.speed is scaled with shared SLOW_PACE, and currently root/stun/staggered patients are not newly selected. Future ordinary volley selection requires non-hull attacker, actual current range, native minimum range, canReach and an existing aimed attack. Mounted/ship future volleys are excluded rather than incorrectly using the hull cooldown."
    },
    {
      "topic": "Already flying shots are separate from future reloads",
      "files": [
        "src/ai/bootstrap_1/deck-recovery.ts:153",
        "src/shared/sim.ts:3029"
      ],
      "finding": "Actual targeted projectiles arriving within the window are counted separately with their saved damageProfile or the native sourceKind/defenseTower fallback, and armorAlreadyApplied is respected. The future volley starts on the next native eligible attack clock, so the already launched shot is not counted again merely because it is still flying. Aim delay, future movement and future status/armor changes are not a cloned execution."
    },
    {
      "topic": "Existing front must survive its modeled additional burden",
      "files": [
        "src/ai/bootstrap_1/deck-recovery.ts:164"
      ],
      "finding": "A front is actual same-deck available automatic-attacking crew, with no queue or conflicting owner and lifetime beyond the estimated walk window. It must be closer to every aimed foe than the retreat endpoint, and HP must exceed transferred modeled volley plus its own flying damage and other current aimed ordinary attackers. This prevents the previously noted known-load/expiry countercases and prevents two patients already lethal under the same model from simply using each other as a front. It remains an estimate against current non-hull basic fire, not a front survival guarantee."
    },
    {
      "topic": "No hardcoded actor, map or arbitrary timeout",
      "files": [
        "src/ai/bootstrap_1/deck-recovery.ts"
      ],
      "finding": "Production logic contains no fixture IDs/map/seed/tick checks. It uses the actual hull profile, current weapon and unit statistics, shared15think cadence and geometric rear endpoint, and does not require an invented timeout. The only prototype IDs occur in tests."
    }
  ],
  "knownNonblockingModelLimits": [
    {
      "scope": "Target/source damage adjustments",
      "evidence": "sim.ts2813 outgoingDamageMultiplier and3258 attackDamageAgainstTarget",
      "finding": "Future volley currently passes foe.attackDamage into resolveUnitDamage. The common resolver handles target protection, not casterSlayer(ordinary ashChieftain22→caster33), scorch bonus(ravager+7/runner+5), or source curse/brace/transport-deck output reductions. Consequently this is not exact full native damage; some adjustments raise and others lower it. Actual35595 three dragons and patient have none of these conditions."
    },
    {
      "scope": "Only normal unit future fire is modeled",
      "finding": "Ship/mounted batteries, towers, skills, splash, new targets and new movement are not a future volley forecast. Existing flying shots may originate from any source, but entry still requires at least one aimed non-hull ordinary attacker. Do not call this universal deck danger detection or proof of no damage transfer."
    },
    {
      "scope": "Planner commitment may continue while withdrawing",
      "evidence": "policy/naval.ts458 continuing coastalRetreat returns before fleetTarget clears/updates oldcombat; fleet-engagement.ts clears when normal target selection resumes",
      "finding": "The post engagement predicate can remain true during an existing withdrawal because a planner target is still committed. That is conservative retention of its own posture, not proof a distant engagement remains in weapon contact. A new accepted order still preempts it."
    },
    {
      "scope": "Current protection and physical path",
      "finding": "Protection duration, future body/heading changes, targeting and collision outcomes are not integrated forward. The walk window is a current straight-path estimate plus15ticks, not a guarantee that native movement will finish on that tick."
    }
  ],
