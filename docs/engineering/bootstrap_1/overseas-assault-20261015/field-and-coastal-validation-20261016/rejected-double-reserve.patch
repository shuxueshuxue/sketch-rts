+
+it('keeps an issued colony hall funded until native construction actually pays for its foundation', () => {
+  const saved = JSON.parse(gunzipSync(readFileSync(new URL('./fixtures/naval-saving-hall-32940.json.gz', import.meta.url))).toString());
+  const game = createGame('bareDuel'); restoreSnapshotIntoGame(game, saved.snapshot, saved.nextId);
+  const memory = structuredClone(saved.memories.p0);
+  const context = (snapshot: ReturnType<typeof snapshotGame>) => bootstrapPolicyContext(snapshot, 'p0', 'v9_archer', { memory, teams: game.teams });
+  const initial = snapshotGame(game);
+  for (const command of planBootstrapEconomy(initial, 'p0', context(initial))) issuePlayerCommand(game, 'p0', command);
+  const unpaid = snapshotGame(game);
+  expect(unpaid.players.p0!.gold).toBeCloseTo(453.51);
+  expect(unpaid.units.find(unit => unit.id === 'unit-p0-worker-3')!.order).toMatchObject({ type: 'build', buildingKind: 'townHall' });
+  const foundation = () => game.buildings.find(building => building.owner === 'p0' && building.kind === 'townHall'
+    && building.x === 8208 && building.y === 7120);
+  expect(foundation()).toBeUndefined();
+  expect(navalBudgetReserve(unpaid, 'p0', context(unpaid))).toBe(400);
+
+  // Native construction, rather than issuing the order, releases the funds.
+  while (!foundation() && game.tick < saved.tick + 1200) stepGame(game);
+  expect(foundation()).toMatchObject({ complete: false });
+  const paid = snapshotGame(game);
+  expect(paid.units.find(unit => unit.id === 'unit-p0-worker-3')!.order).toMatchObject({ type: 'repair', buildingId: foundation()!.id });
+  expect(navalBudgetReserve(paid, 'p0', context(paid))).toBe(0);
+});
