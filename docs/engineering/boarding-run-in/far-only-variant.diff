+// @@@boarding-run-in - A ship sent to board from far off sails in under canvas first: an ordinary course toward the berth
+// that ends a length short of it, on its own side. Within a length and a half of the berth it docks as precisely as
+// before (undefined here); docking alone from far off pivoted and crept the whole way in.
+export function boardingRunIn(ship:Unit,berth:ShipPose):Point|undefined {
+  const length=shipProfile(ship)!.length,dx=ship.x-berth.x,dy=ship.y-berth.y,gap=Math.hypot(dx,dy);
+  return gap<=length*1.5 ? undefined : {x:berth.x+dx/gap*length,y:berth.y+dy/gap*length};
+}
 export function beginShipBoarding(map:GameMap,units:readonly Unit[],source:Unit,target:Unit,tick:number,snapshot:CrewSnapshot={}):boolean {
   if(shipBoardingRefusal(source,units,tick,snapshot) || shipBoardingTargetRefusal(source,target) || !shipBoardingGoal(map,units,source,target))return false;
   crewRules.set(source,snapshot);
