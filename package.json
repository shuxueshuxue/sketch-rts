{
  "name": "sketch-rts",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sketch": "tsx tools/cli/main.ts",
    "dev": "tsx src/server/index.ts",
    "dev:static": "VITE_SKETCH_RTS_DEPLOYMENT=static vite --host 0.0.0.0",
    "dev:lan": "HOST=0.0.0.0 tsx src/server/index.ts",
    "server": "tsx src/server/index.ts",
    "test": "vitest",
    "benchmark:ai-v9-gauntlet": "tsx scripts/ai-v9-gauntlet-benchmark.ts",
    "benchmark:ai-gauntlet": "tsx scripts/ai-version-gauntlet.ts",
    "play:ai": "tsx scripts/ai-playtest.ts",
    "art:ships": "python3 tools/art/build-ships.py",
    "art:navigation": "tsx scripts/build-navigation-masks.ts",
    "benchmark:naval-navigation": "tsx scripts/naval-navigation-benchmark.ts",
    "benchmark:naval-runtime": "tsx scripts/naval-runtime-stress.ts",
    "benchmark:browser-runtime": "node --import tsx scripts/browser-runtime-benchmark.mjs",
    "art:buildings": "python3 tools/art/build-buildings.py",
    "record": "tsx src/recorder/cli.ts",
    "test:sdk-ai-ab": "vitest --run src/ai/ab-test.test.ts",
    "test:sdk-ai-policy": "vitest --run src/ai/policy.test.ts",
    "test:sdk-agent-player": "tsx scripts/sdk-agent-player.ts",
    "test:sdk-agent-15v15": "tsx scripts/sdk-agent-15v15.ts",
    "test:sdk-smoke": "tsx scripts/sdk-smoke.ts",
    "test:sdk-savegame": "tsx scripts/sdk-savegame.ts",
    "test:e2e-room-flow": "node scripts/e2e-room-flow.mjs",
    "test:e2e-room-sync": "node --import tsx scripts/room-sync-yatu.mjs",
    "test:e2e-brutal": "node scripts/e2e-brutal-spec.mjs",
    "test:yatu": "node scripts/yatu-player-loop.mjs",
    "test:sdk-effect-proof": "tsx scripts/sdk-effect-proof.ts",
    "audit:crash-inventory": "tsx scripts/crash-inventory.ts",
    "build": "tsc --noEmit && vite build",
    "build:server-bundle": "node --import tsx scripts/build-server-bundle.ts",
    "build:production": "npm run build && npm run build:server-bundle && node --import tsx scripts/production-client-bootstrap.ts dist",
    "build:server": "tsc --noEmit && VITE_SKETCH_RTS_DEPLOYMENT=server vite build",
    "build:static": "tsc --noEmit && VITE_SKETCH_RTS_DEPLOYMENT=static vite build",
    "benchmark:six-player-ticks": "tsx scripts/six-player-tick-probe.ts",
    "benchmark:ai-room": "tsx scripts/ai-room-gauntlet-benchmark.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "express": "^4.19.2",
    "three": "^0.186.1",
    "vite": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "gifenc": "^1.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "bin": {
    "sketch": "bin/sketch"
  }
}
